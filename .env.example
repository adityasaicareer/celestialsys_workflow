# LLM Configuration
# Provider: openai or openrouter
LLM_PROVIDER=openrouter
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openai/gpt-4-turbo-preview
LLM_TEMPERATURE=0.0
# OpenRouter specific settings (only used when LLM_PROVIDER=openrouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Workflow Configuration
WORKFLOW_CHECKPOINT_DB=sqlite:///workflow_checkpoints.db
MAX_RETRIES_PER_AGENT=5
MAX_TOTAL_RETRIES=20

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Database Configuration (for generated applications)
POSTGRES_IMAGE=postgres:15
POSTGRES_PORT=5432
MONGO_IMAGE=mongo:7
MONGO_PORT=27017

# Generated Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored

# Output Directories
OUTPUT_DIR=./output
BACKEND_OUTPUT_DIR=./backend
FRONTEND_OUTPUT_DIR=./frontend
